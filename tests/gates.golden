# job<TAB>normalised gate. Regenerate: scripts/check-caller-contract.py --print-gates
build	github.event_name == 'pull_request' && github.event.pull_request.draft == false && github.event.pull_request.head.repo.full_name == github.repository && !contains(github.event.pull_request.labels.*.name, 'no-review') && !inputs.skip_build
review	github.event_name == 'pull_request' && github.event.pull_request.draft == false && github.event.pull_request.head.repo.full_name == github.repository && !contains(github.event.pull_request.labels.*.name, 'no-review') && !cancelled() && needs.build.result != 'cancelled'
respond	( github.event_name == 'issue_comment' && github.event.issue.pull_request != null && github.event.issue.state == 'open' && github.event.comment.user.type != 'Bot' && !contains(github.event.issue.labels.*.name, 'no-review') ) || ( github.event_name == 'pull_request_review_comment' && github.event.pull_request.draft == false && github.event.pull_request.head.repo.full_name == github.repository && github.event.comment.user.type != 'Bot' && !contains(github.event.pull_request.labels.*.name, 'no-review') )
